;
; re_capture -- latch the RE command byte on every TU00N strobe.
;
; TU00N (GP27) is the CPU's ~1.2 us command one-shot (CE10, "UNIV 1.2 us").
; RE01N-RE07N sit on GP16..GP22; RE00N sits on GP28 (GP14/GP15 are reserved,
; so the RE bus is no longer contiguous). The SM samples the whole 13-pin
; window GP16..GP28 in one shot -- bits 0-6 = RE01-07, bit 12 = RE00; the
; bits in between (GP23-25 CYW43, GP26 TU03N, GP27 TU00N itself) are junk
; and masked out when the CPU reassembles the byte (wire_rx.c).
; All pins use GPIO_OVERRIDE_INVERT, so logically TU00N reads 1 while the
; strobe is asserted and `in pins` yields the active-high RE bits.
;
; The sample is taken ~300 ns into the pulse (mid-pulse, well inside the
; window, immune to CPU IRQ latency). One capture per strobe: we wait for
; the strobe to end before re-arming.
;
; Each captured word lands in the RX FIFO; the CPU (core1) takes an IRQ on
; RX-not-empty and dispatches per the command matrix (ARCHITECTURE.md sec.4).
;
; Clocking: 10 MHz (tick = 100 ns).

.program re_capture

.wrap_target
    wait 1 gpio 27  [2]   ; TU00N asserted; +300 ns to mid-pulse
    in pins, 13           ; sample GP16..GP28 (RE01-07 + RE00)
    push block            ; -> RX FIFO (IRQ via RXNEMPTY)
    wait 0 gpio 27        ; strobe end: exactly one capture per pulse
.wrap

% c-sdk {
#include "hardware/clocks.h"

#define RE_CAPTURE_PIN_TU00N 27u
#define RE_CAPTURE_PIN_RE1   16u   /* RE01..RE07 = GP16..GP22 */
#define RE_CAPTURE_PIN_RE0   28u

static inline void re_capture_in_pin(uint pin)
{
    /* gpio_init also clears the RP2350 pad-isolation latch -- without it
     * the pad input never reaches the PIO (or gpio_get). */
    gpio_init(pin);
    gpio_set_inover(pin, GPIO_OVERRIDE_INVERT);
    gpio_set_dir(pin, false);
}

static inline void re_capture_program_init(PIO pio, uint sm, uint offset)
{
    re_capture_in_pin(RE_CAPTURE_PIN_TU00N);
    re_capture_in_pin(RE_CAPTURE_PIN_RE0);
    for (uint pin = RE_CAPTURE_PIN_RE1; pin < RE_CAPTURE_PIN_RE1 + 7; pin++)
        re_capture_in_pin(pin);

    pio_sm_config c = re_capture_program_get_default_config(offset);
    sm_config_set_in_pins(&c, RE_CAPTURE_PIN_RE1);
    sm_config_set_in_shift(&c, false /*shift left*/, false, 32);
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / 10e6f);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
