;
; presenter -- drive the LU data bus, LU08N character strobe and FININ
; toward the GE-120 channel-1 input.
;
; One TX FIFO word per presented nibble:
;
;   bits  8:0   OUT field -> pins GP0..GP8
;                 GP0-3  LU00N-03N  the nibble (only these carry data;
;                 GP4-7  LU04N-07N  always 0 = inactive)
;                 GP8    FININ      1 only on the LOW nibble of the last column
;   bits 16:9   W  = LU08N strobe width, in SM ticks (8 bits, <=25.5 us @10MHz)
;   bits 31:17  G  = gap after the strobe, in SM ticks (15 bits, <=3.27 ms)
;
; Side-set (1 bit): GP9 = LU08N (logical: 1 = strobe asserted).
;
; LUPOB (GP10) is NOT part of this program: the GE latches its *fronts*, so
; it is a per-CARD handshake, not a per-character complement. core1's feeder
; drives it as a software GPIO (wire_tx_set_ready): high = ready while armed
; and waiting, low from command-accept (before the first strobe) until the
; FININ release / card advance. Holding it low across the whole card also
; satisfies PELEA = !(LU08 & LUPO) (gemu signals.h:933). Ready is wire-HIGH
; (bench-confirmed): GP10 drives non-inverted.
;
; All other GE wires are active-low; their pins use GPIO_OVERRIDE_INVERT so
; this program (and the firmware) works in active-high logic.
;
; Clocking: run the SM at 10 MHz (clkdiv = sys_clk/10MHz), 1 tick = 100 ns.
; Data setup before the strobe edge is the 2 instructions between `out pins`
; and the first strobe tick (~200 ns) plus the [3] delay = ~0.5 us default.

.program presenter
.side_set 1

.wrap_target
    pull block      side 0        ; idle: LU08 inactive; wait for a nibble
    out pins, 9     side 0 [3]    ; data + FININ on the pins; setup time S
    out x, 8        side 0        ; X <- W ticks
wloop:
    jmp x-- wloop   side 1        ; strobe: LU08 asserted, held W ticks
    out y, 15       side 0        ; Y <- G ticks; strobe released
gloop:
    jmp y-- gloop   side 0        ; inter-character gap
.wrap

% c-sdk {
#include "hardware/clocks.h"

// GP0..GP8 = OUT (LU00N-07N + FININ); GP9 = side-set (LU08N).
// GP10 (LUPOB) is a software GPIO owned by the feeder -- see wire_tx.c.
static inline void presenter_program_init(PIO pio, uint sm, uint offset)
{
    for (uint pin = 0; pin <= 9; pin++) {
        pio_gpio_init(pio, pin);
        gpio_set_outover(pin, GPIO_OVERRIDE_INVERT);  /* active-low wires */
    }

    pio_sm_config c = presenter_program_get_default_config(offset);
    sm_config_set_out_pins(&c, 0, 9);
    sm_config_set_sideset_pins(&c, 9);
    sm_config_set_out_shift(&c, true /*shift right*/, false, 32);
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / 10e6f); /* 100 ns tick */

    pio_sm_set_consecutive_pindirs(pio, sm, 0, 10, true /*out*/);
    /* Disarmed idle: everything inactive. */
    pio_sm_set_pins_with_mask(pio, sm, 0, 0x3FFu);
    pio_sm_init(pio, sm, offset, &c);
    /* CPU enables the SM on ARM. */
}

/* Pack one presentation word. w_ticks/g_ticks in 100 ns units. */
static inline uint32_t presenter_word(uint8_t nibble, bool fini,
                                      uint16_t w_ticks, uint16_t g_ticks)
{
    return  (uint32_t)(nibble & 0x0Fu)
          | ((uint32_t)(fini ? 1u : 0u) << 8)
          | ((uint32_t)(w_ticks & 0xFFu) << 9)
          | ((uint32_t)(g_ticks & 0x7FFFu) << 17);
}
%}
