;
; presenter -- drive the LU data bus, LU08N character strobe, LUPOR and FININ
; toward the GE-120 channel-1 input.
;
; One TX FIFO word per presented nibble:
;
;   bits  8:0   OUT field -> pins GP0..GP8
;                 GP0-3  LU00N-03N  the nibble (only these carry data;
;                 GP4-7  LU04N-07N  always 0 = inactive)
;                 GP8    FININ      1 only on the LOW nibble of the last column
;   bits 16:9   W  = LU08N strobe width, in SM ticks (8 bits, <=25.5 us @10MHz)
;   bits 31:17  G  = gap after the strobe, in SM ticks (15 bits, <=3.27 ms)
;
; Side-set (2 bits, base GP9):
;   bit 0 -> GP9   LU08N  (logical: 1 = strobe asserted)
;   bit 1 -> GP10  LUPOR  (logical: 1 = ready)
; The two are always written as complements, enforcing the PELEA invariant
; PELEA = !(LU08 & LUPOR)  (gemu signals.h:933): the reader is never "ready"
; while a character is on the lines.
;
; All GE wires are active-low; every pin uses GPIO_OVERRIDE_INVERT so this
; program (and the firmware) works in active-high logic.
;
; Clocking: run the SM at 10 MHz (clkdiv = sys_clk/10MHz), 1 tick = 100 ns.
; Data setup before the strobe edge is the 2 instructions between `out pins`
; and the first strobe tick (~200 ns) plus the [3] delay = ~0.5 us default.
;
; Idle/disarmed levels are set by the CPU before enabling the SM:
; data 0, FININ 0, LU08 0, LUPOR = 1 when armed / 0 when disarmed.

.program presenter
.side_set 2

.wrap_target
    pull block      side 0b10        ; idle: LU08=0, LUPOR=1; wait for a nibble
    out pins, 9     side 0b10 [3]    ; data + FININ on the pins; setup time S
    out x, 8        side 0b10        ; X <- W ticks
wloop:
    jmp x-- wloop   side 0b01        ; strobe: LU08=1, LUPOR=0, held W ticks
    out y, 15       side 0b10        ; Y <- G ticks; strobe released
gloop:
    jmp y-- gloop   side 0b10        ; inter-character gap
.wrap

% c-sdk {
#include "hardware/clocks.h"

// GP0..GP8 = OUT (LU00N-07N + FININ); GP9,GP10 = side-set (LU08N, LUPOR).
static inline void presenter_program_init(PIO pio, uint sm, uint offset)
{
    for (uint pin = 0; pin <= 10; pin++) {
        pio_gpio_init(pio, pin);
        gpio_set_outover(pin, GPIO_OVERRIDE_INVERT);  /* active-low wires */
    }

    pio_sm_config c = presenter_program_get_default_config(offset);
    sm_config_set_out_pins(&c, 0, 9);
    sm_config_set_sideset_pins(&c, 9);
    sm_config_set_out_shift(&c, true /*shift right*/, false, 32);
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / 10e6f); /* 100 ns tick */

    pio_sm_set_consecutive_pindirs(pio, sm, 0, 11, true /*out*/);
    /* Disarmed idle: everything inactive, including LUPOR (not ready). */
    pio_sm_set_pins_with_mask(pio, sm, 0, 0x7FFu);
    pio_sm_init(pio, sm, offset, &c);
    /* CPU enables the SM (and raises LUPOR) on ARM. */
}

/* Pack one presentation word. w_ticks/g_ticks in 100 ns units. */
static inline uint32_t presenter_word(uint8_t nibble, bool fini,
                                      uint16_t w_ticks, uint16_t g_ticks)
{
    return  (uint32_t)(nibble & 0x0Fu)
          | ((uint32_t)(fini ? 1u : 0u) << 8)
          | ((uint32_t)(w_ticks & 0xFFu) << 9)
          | ((uint32_t)(g_ticks & 0x7FFFu) << 17);
}
%}
